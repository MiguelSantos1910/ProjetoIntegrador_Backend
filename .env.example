# Copie este arquivo para ".env" (que já está no .gitignore) e ajuste os valores.
# Sem esse arquivo, o projeto roda local com SQLite normalmente.

SECRET_KEY=troque-por-uma-chave-aleatoria-grande
DEBUG=True
ALLOWED_HOSTS=*

# Deixe comentado/ausente para usar SQLite local (arquivo db.sqlite3 na
# pasta do projeto). Na Azure, configure esta mesma variável nas
# "Configurações do aplicativo" (Application Settings) apontando para um
# caminho persistente FORA de /home/site/wwwroot (senão o banco some a
# cada novo deploy):
# DATABASE_URL=sqlite:////home/data/db.sqlite3

# Em produção, troque por False e liste os domínios reais em CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://easyassets-web.azurewebsites.net
