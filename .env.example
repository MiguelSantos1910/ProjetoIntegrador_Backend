# Copie este arquivo para ".env" (que já está no .gitignore) e ajuste os valores.
# Sem esse arquivo, o projeto roda local com SQLite normalmente.

SECRET_KEY=troque-por-uma-chave-aleatoria-grande
DEBUG=True
ALLOWED_HOSTS=*

# Deixe comentado/ausente para usar SQLite local.
# Quando for para a Azure, descomente e preencha com os dados do
# Azure Database for PostgreSQL (Configurações de Conexão no portal):
# DATABASE_URL=postgres://usuario:senha@nome-do-servidor.postgres.database.azure.com:5432/easyassets?sslmode=require

# Em produção, troque por False e liste os domínios reais em CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://easyassets-web.azurewebsites.net
