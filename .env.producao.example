# Modelo do .env de PRODUÇÃO (ex.: PythonAnywhere). Copie para ".env" na
# pasta do projeto, no servidor, e troque SEUUSUARIO e os endereços.
# Nunca envie o .env real para o GitHub.

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cole-aqui-a-chave-gerada

DEBUG=False
ALLOWED_HOSTS=SEUUSUARIO.pythonanywhere.com

# Só o painel publicado pode chamar a API pelo navegador.
# (O app mobile não usa CORS, então não precisa estar aqui.)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://easy-asset.vercel.app

# Necessário para o login do /admin/ em HTTPS.
CSRF_TRUSTED_ORIGINS=https://SEUUSUARIO.pythonanywhere.com

# Redireciona HTTP para HTTPS (o PythonAnywhere também tem "Force HTTPS").
SECURE_SSL_REDIRECT=True

# Banco e backups: no PythonAnywhere o disco é persistente, então os
# padrões (db.sqlite3 e backups_banco/ na pasta do projeto) funcionam.
# DATABASE_URL=sqlite:////home/SEUUSUARIO/dados/db.sqlite3
# BACKUP_DIR=/home/SEUUSUARIO/dados/backups_banco
BACKUP_MAX=10
